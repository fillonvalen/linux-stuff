alias ebrc='vi ~/.bashrc'
alias eba='vi ~/.bash_aliases'
alias sba='source ~/.bash_aliases'
alias sbrc='source ~/.bashrc'
alias shutd='sudo shutdown -h now'
alias reboot='sudo reboot'
alias svi='sudo vi'
alias scat='sudo cat'
alias l='ls -1'
alias rm='rm -i'
alias mkdir='mkdir -v'
alias rmdir='rmdir -v'
alias mv='mv -v'
alias smv='sudo mv -v'
alias cp='cp -v'
alias scp='sudo cp -v'
alias ws='cd ~/pi'
alias f=find
alias sf='sudo find'
alias alconf='vi ~/.config/alacritty/alacritty.toml'
alias gcc='/usr/bin/time -f "(U %U\tS %S\tR %E)" gcc'
alias time=/usr/bin/time
alias pal='/home/$USER/pi/pcal/pcal'
alias men="compgen -c | fzf --bind 'enter:execute(man {})'"
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias hist='history | sort | uniq | fzf'
