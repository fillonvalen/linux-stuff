bar {
        status_command i3status
        colors {
            background #222222
            statusline #ffffff
            separator  #484e50

            # Class            Border  Bground Text
            focused_workspace  #5e5c64 #5e5c64 #ffffff
            active_workspace   #000000 #000000 #ffffff
            inactive_workspace #222222 #222222 #888888
            urgent_workspace   #a51d2d #900000 #ffffff
            binding_mode       #a51d2d #900000 #ffffff
          }
}
floating_maximum_size 1280 x 720

# Class                   Border  Bground Text    Indicator Child_border
client.unfocused          #5e5c64 #5e5c64 #888888 #5e5c64   #5e5c64
client.focused_inactive   #deddda #deddda #000000 #deddda   #deddda
client.focused            #333333 #222222 #ffffff #292d2e   #222222
client.urgent             #2f343a #900000 #ffffff #900000   #900000
client.placeholder        #000000 #0c0c0c #ffffff #000000   #0c0c0c
client.background               #ffffff

bindsym $mod+d exec --no-startup-id dmenu_run -nf "#bbbbbb" -nb "#222222" -sb "#000000" -sf "#ffffff" -fn "monospace:size=10" -p "dmenu"
